# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL / Supabase Transaction Pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/abhisaran
SPRING_DATASOURCE_USERNAME=abhisaran_user
SPRING_DATASOURCE_PASSWORD=abhisaran_local_password_secure_123

# Security & Secrets (Must be at least 32 bytes / 256-bit)
JWT_SECRET=super_secure_abhisaran_jwt_secret_key_at_least_32_bytes_long_2026

# First Admin Bootstrap (Executed only if zero admins exist; flagged must_change_password)
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin#Bootstrap2026!

# Privacy Configuration
STORE_LOCATION_NAMES=true

# Storage (Supabase Private Storage Bucket for Evidence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=evidence-private

# Assistive AI Service Configuration (Internal Server-to-Server Only)
FEATURE_AI=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=internal_secret_token_between_spring_and_fastapi_32bytes

# Frontend API Configuration (Relative /api/v1 or custom URL)
VITE_API_BASE_URL=/api/v1
