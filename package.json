{
  "name": "abhisaran-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Abhisaran Audit & ACS Platform",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:api": "mvn -f apps/api/pom.xml spring-boot:run",
    "test:api": "mvn -f apps/api/pom.xml test",
    "dev:ai": "python -m uvicorn app.main:app --app-dir apps/ai --reload --port 8000",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
